{%- import_yaml tpldir ~ "/defaults.yaml" as defaults %}
{%- import_yaml tpldir ~ "/osfamilymap.yaml" as osfamilymap %}
{%- set nginx = salt['defaults.merge'](defaults.nginx,
      salt['grains.filter_by'](osfamilymap,
      grain='os_family',
      merge=salt['pillar.get']('nginx:lookup', {}),
      default='Debian'),
      in_place=False) %}
