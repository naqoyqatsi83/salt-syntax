#   -> True
filters.to_bool:
  test.nop:
    - result: {{ ('yes' | to_bool) | tojson }}

# to_num
#   '42' | to_num
#   -> 42
filters.to_num:
  test.nop:
    - result: {{ ('42' | to_num) | tojson }}

# str_to_num -- alias of to_num
#   '4.2' | str_to_num
#   -> 4.2
filters.str_to_num:
  test.nop:
    - result: {{ ('4.2' | str_to_num) | tojson }}

# is_hex
#   'ff' | is_hex
#   -> True
filters.is_hex:
  test.nop:
    - result: {{ ('ff' | is_hex) | tojson }}

# contains_whitespace
#   'a b' | contains_whitespace
#   -> True
filters.contains_whitespace:
  test.nop:
    - result: {{ ('a b' | contains_whitespace) | tojson }}

# human_to_bytes
#   '2 KiB' | human_to_bytes
#   -> 2048
filters.human_to_bytes:
  test.nop:
    - result: {{ ('2 KiB' | human_to_bytes) | tojson }}

# to_camelcase
#   'snake_case_here' | to_camelcase
#   -> snakeCaseHere
filters.to_camelcase:
  test.nop:
    - result: {{ ('snake_case_here' | to_camelcase) | tojson }}

# to_snake_case
#   'camelCaseHere' | to_snake_case
#   -> camel_case_here
filters.to_snake_case:
  test.nop:
    - result: {{ ('camelCaseHere' | to_snake_case) | tojson }}

# check_whitelist_blacklist -- globs or regexes
#   'web01' | check_whitelist_blacklist(whitelist='web*')
#   -> True
filters.check_whitelist_blacklist:
  test.nop:
    - result: {{ ('web01' | check_whitelist_blacklist(whitelist='web*')) | tojson }}

# to_bytes
#   'abc' | to_bytes
#   -> b'abc'
filters.to_bytes:
  test.nop:
    - result: {{ ('abc' | to_bytes) | string | tojson }}

# quote -- shell quoting
#   "it's here" | quote
#   -> 'it'"'"'s here'
filters.quote:
  test.nop:
    - result: {{ ("it's here" | quote) | tojson }}

# regex_escape
#   'a.b*c' | regex_escape
#   -> a\.b\*c
filters.regex_escape:
  test.nop:
    - result: {{ ('a.b*c' | regex_escape) | tojson }}

# regex_search -- the groups
#   'abcd' | regex_search('^(.*)BC(.*)$', ignorecase=True)
#   -> ('a', 'd')
filters.regex_search:
  test.nop:
    - result: {{ ('abcd' | regex_search('^(.*)BC(.*)$', ignorecase=True)) | tojson }}

# regex_search -- no groups: 3006 gives (), 3007+ the whole match
#   'abcd' | regex_search('BC', ignorecase=True)
#   -> ('bc',)
filters.regex_search.no_groups:
  test.nop:
    - result: {{ ('abcd' | regex_search('BC', ignorecase=True)) | tojson }}

# regex_match -- the groups
#   'abcd' | regex_match('^(.*)BC(.*)$', ignorecase=True)
#   -> ('a', 'd')
filters.regex_match:
  test.nop:
    - result: {{ ('abcd' | regex_match('^(.*)BC(.*)$', ignorecase=True)) | tojson }}

# regex_match -- no groups: 3006 gives (), 3007+ the whole match
#   'abcd' | regex_match('ABC', ignorecase=True)
#   -> ('abc',)
filters.regex_match.no_groups:
  test.nop:
    - result: {{ ('abcd' | regex_match('ABC', ignorecase=True)) | tojson }}

# regex_replace
#   'lets replace spaces' | regex_replace('\\s+', '__')
#   -> lets__replace__spaces
filters.regex_replace:
  test.nop:
    - result: {{ ('lets replace spaces' | regex_replace('\\s+', '__')) | tojson }}

# indent -- Salt's own indent
#   'a\nb' | indent(2)
#   -> a\n  b
filters.indent:
  test.nop:
    - result: {{ ('a\nb' | indent(2)) | tojson }}

# tojson -- escapes < > & '
#   {'a': '<b>'} | tojson
#   -> {"a": "\u003cb\u003e"}
filters.tojson:
  test.nop:
    - result: {{ ({'a': '<b>'} | tojson) | tojson }}

# uuid -- deterministic: UUID5 of the value
#   'random' | uuid
#   -> 3652b285-26ad-588e-a5dc-c2ee65edc804
filters.uuid:
  test.nop:
    - result: {{ ('random' | uuid) | tojson }}


