# -*- coding: utf-8 -*-
# vim: ft=sls
#
# Every Salt Jinja filter, one test.nop state each -- open with the rendered
# preview (Ctrl+K V) with saltSyntax.saltVersion set to 3008.
# The 3006 (LTS) version of this file is salt_filters_3006.sls -- it lacks
# to_entries / from_entries, which 3006 doesn't have.
# `# ->` is the filter's own output as
# printed by Jinja -- generated by rendering each line, with the preview's filters
# verified against Salt's own implementations (test/salt-filter-parity.test.py).
# `- result:` wraps it in `| tojson` so the file stays valid YAML whatever it returns.
# The example lines leave out the double braces on purpose: Jinja (and so Salt)
# renders an expression tag even inside a # comment.


#------------------------------------------------------------------------------
# Serializers (SerializerExtension)
#------------------------------------------------------------------------------

# yaml -- flow style by default
#   {'a': [1, 2]} | yaml
#   -> {a: [1, 2]}
filters.yaml:
  test.nop:
    - result: {{ ({'a': [1, 2]} | yaml) | tojson }}

# json -- keys sorted
#   {'b': 1, 'a': 2} | json
#   -> {"a": 2, "b": 1}
filters.json:
  test.nop:
    - result: {{ ({'b': 1, 'a': 2} | json) | tojson }}

# load_yaml -- parses YAML text
#   'a: [1, 2]' | load_yaml
#   -> {'a': [1, 2]}
filters.load_yaml:
  test.nop:
    - result: {{ ('a: [1, 2]' | load_yaml) | tojson }}

# load_json -- parses JSON text
#   '{"a": 1}' | load_json
#   -> {'a': 1}
filters.load_json:
  test.nop:
    - result: {{ ('{"a": 1}' | load_json) | tojson }}

# load_text -- text as-is
#   'plain' | load_text
#   -> plain
filters.load_text:
  test.nop:
    - result: {{ ('plain' | load_text) | tojson }}


#------------------------------------------------------------------------------
# Lists, sets and sequences (salt/utils/jinja.py, data.py)
#------------------------------------------------------------------------------

# unique
#   ['a', 'b', 'a'] | unique
#   -> ['a', 'b']
filters.unique:
  test.nop:
    - result: {{ (['a', 'b', 'a'] | unique) | tojson }}

# min
#   [3, 1, 2] | min
#   -> 1
filters.min:
  test.nop:
    - result: {{ ([3, 1, 2] | min) | tojson }}

# max
#   [3, 1, 2] | max
#   -> 3
filters.max:
  test.nop:
    - result: {{ ([3, 1, 2] | max) | tojson }}

# avg -- always a float
#   [1, 2, 3, 4] | avg
#   -> 2.5
filters.avg:
  test.nop:
    - result: {{ ([1, 2, 3, 4] | avg) | tojson }}

# union
#   [1, 2, 3, 4] | union([2, 4, 6])
#   -> [1, 2, 3, 4, 6]
filters.union:
  test.nop:
    - result: {{ ([1, 2, 3, 4] | union([2, 4, 6])) | tojson }}

# intersect
#   [1, 2, 3, 4] | intersect([2, 4, 6])
#   -> [2, 4]
filters.intersect:
  test.nop:
    - result: {{ ([1, 2, 3, 4] | intersect([2, 4, 6])) | tojson }}

# difference
#   [1, 2, 3, 4] | difference([2, 4, 6])
#   -> [1, 3]
filters.difference:
  test.nop:
    - result: {{ ([1, 2, 3, 4] | difference([2, 4, 6])) | tojson }}

# symmetric_difference
#   [1, 2, 3, 4] | symmetric_difference([2, 4, 6])
#   -> [1, 3, 6]
filters.symmetric_difference:
  test.nop:
    - result: {{ ([1, 2, 3, 4] | symmetric_difference([2, 4, 6])) | tojson }}

# sequence -- wraps a non-list
#   'item' | sequence
#   -> ['item']
filters.sequence:
  test.nop:
    - result: {{ ('item' | sequence) | tojson }}

# skip -- always empty
#   'hidden' | skip
#   -> 
filters.skip:
  test.nop:
    - result: {{ ('hidden' | skip) | tojson }}

# flatten -- drops None / 'null' unless preserve_nulls=True
#   [1, [2, [3, None]], 'null'] | flatten
#   -> [1, 2, 3]
filters.flatten:
  test.nop:
    - result: {{ ([1, [2, [3, None]], 'null'] | flatten) | tojson }}

# is_iter -- strings don't count
#   [1, 2] | is_iter
#   -> True
filters.is_iter:
  test.nop:
    - result: {{ ([1, 2] | is_iter) | tojson }}

# is_list
#   [1, 2] | is_list
#   -> True
filters.is_list:
  test.nop:
    - result: {{ ([1, 2] | is_list) | tojson }}

# sorted_ignorecase
#   ['b', 'A', 'c'] | sorted_ignorecase
#   -> ['A', 'b', 'c']
filters.sorted_ignorecase:
  test.nop:
    - result: {{ (['b', 'A', 'c'] | sorted_ignorecase) | tojson }}

# substring_in_list
#   'yz' | substring_in_list(['xyz', 'abc'])
#   -> True
filters.substring_in_list:
  test.nop:
    - result: {{ ('yz' | substring_in_list(['xyz', 'abc'])) | tojson }}

# exactly_one_true
#   [True, False, False] | exactly_one_true
#   -> True
filters.exactly_one_true:
  test.nop:
    - result: {{ ([True, False, False] | exactly_one_true) | tojson }}

# exactly_n_true
#   [True, False, True] | exactly_n_true(2)
#   -> True
filters.exactly_n_true:
  test.nop:
    - result: {{ ([True, False, True] | exactly_n_true(2)) | tojson }}

# compare_lists -- old, new
#   [1, 2, 3] | compare_lists([2, 3, 4])
#   -> {'new': [4], 'old': [1]}
filters.compare_lists:
  test.nop:
    - result: {{ ([1, 2, 3] | compare_lists([2, 3, 4])) | tojson }}

# compare_dicts -- old, new
#   {'a': 1, 'b': 2} | compare_dicts({'a': 1, 'b': 3})
#   -> {'b': {'old': 2, 'new': 3}}
filters.compare_dicts:
  test.nop:
    - result: {{ ({'a': 1, 'b': 2} | compare_dicts({'a': 1, 'b': 3})) | tojson }}

# method_call -- calls str.split
#   'a,b,c' | method_call('split', ',')
#   -> ['a', 'b', 'c']
filters.method_call:
  test.nop:
    - result: {{ ('a,b,c' | method_call('split', ',')) | tojson }}


#------------------------------------------------------------------------------
# Dicts (salt/utils/data.py, dictupdate.py)
#------------------------------------------------------------------------------

# traverse -- colon-delimited path, through lists of dicts
#   {'a': {'b': [{'c': 1}]}} | traverse('a:b:c')
#   -> 1
filters.traverse:
  test.nop:
    - result: {{ ({'a': {'b': [{'c': 1}]}} | traverse('a:b:c')) | tojson }}

# set_dict_key_value
#   {} | set_dict_key_value('a:b', 1)
#   -> {'a': {'b': 1}}
filters.set_dict_key_value:
  test.nop:
    - result: {{ ({} | set_dict_key_value('a:b', 1)) | tojson }}

# update_dict_key_value
#   {'a': {'b': {'x': 1}}} | update_dict_key_value('a:b', {'y': 2})
#   -> {'a': {'b': {'x': 1, 'y': 2}}}
filters.update_dict_key_value:
  test.nop:
    - result: {{ ({'a': {'b': {'x': 1}}} | update_dict_key_value('a:b', {'y': 2})) | tojson }}

# append_dict_key_value
#   {'a': {'l': [1]}} | append_dict_key_value('a:l', 2)
#   -> {'a': {'l': [1, 2]}}
filters.append_dict_key_value:
  test.nop:
    - result: {{ ({'a': {'l': [1]}} | append_dict_key_value('a:l', 2)) | tojson }}

# extend_dict_key_value
#   {'a': [1]} | extend_dict_key_value('a', [2, 3])
#   -> {'a': [1, 2, 3]}
filters.extend_dict_key_value:
  test.nop:
    - result: {{ ({'a': [1]} | extend_dict_key_value('a', [2, 3])) | tojson }}

# to_entries -- 3007+ only -- not in 3006
#   {'a': 1, 'b': 2} | to_entries
#   -> [{'key': 'a', 'value': 1}, {'key': 'b', 'value': 2}]
filters.to_entries:
  test.nop:
    - result: {{ ({'a': 1, 'b': 2} | to_entries) | tojson }}

# from_entries -- 3007+ only -- not in 3006
#   [{'key': 'a', 'value': 1}] | from_entries
#   -> {'a': 1}
filters.from_entries:
  test.nop:
    - result: {{ ([{'key': 'a', 'value': 1}] | from_entries) | tojson }}


#------------------------------------------------------------------------------
# Strings, numbers, regex (salt/utils/stringutils.py, jinja.py)
#------------------------------------------------------------------------------

# to_bool -- 'yes'/'1'/'true' only -- 'on' is False
