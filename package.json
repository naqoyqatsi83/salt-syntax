{
  "name": "salt-syntax",
  "displayName": "Salt Syntax",
  "description": "Syntax highlighting, coloring and IntelliSense for SaltStack SLS files (YAML + Jinja2)",
  "version": "0.3.2",
  "publisher": "naqoyqatsi83",
  "author": "naqoyqatsi83",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/naqoyqatsi83/salt-syntax.git"
  },
  "bugs": {
    "url": "https://github.com/naqoyqatsi83/salt-syntax/issues"
  },
  "homepage": "https://github.com/naqoyqatsi83/salt-syntax#readme",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "saltstack",
    "salt",
    "sls",
    "jinja",
    "jinja2",
    "yaml",
    "devops",
    "configuration management"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:sls"
  ],
  "contributes": {
    "languages": [
      {
        "id": "sls",
        "aliases": [
          "SaltStack SLS",
          "Salt State",
          "sls"
        ],
        "extensions": [
          ".sls"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sls",
        "scopeName": "source.sls",
        "path": "./syntaxes/sls.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "sls",
        "path": "./snippets/sls-snippets.json"
      }
    ],
    "configurationDefaults": {
      "[sls]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": true
        }
      }
    }
  },
  "scripts": {
    "package": "vsce package"
  }
}
